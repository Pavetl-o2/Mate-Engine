{
  "avatar": {
    "width": 200,
    "height": 450,
    "scale": 1.0,
    "mode": "glb",
    "type": "glb",
    "glb": {
      "modelPath": "assets/models/avatar.glb"
    },
    "pngtuber": {
      "videoPath": "assets/pngtuber/video.mp4",
      "mouthsPath": "assets/pngtuber/mouths",
      "trackingPath": "assets/pngtuber/tracking.json"
    }
  },
  "behavior": {
    "alwaysOnTop": true,
    "snapThreshold": 30,
    "followWindowsOnMove": true,
    "enableTaskbarSitting": true
  },
  "animations": {
    "idleFrameRate": 6,
    "transitionDuration": 200
  },
  "window": {
    "startMinimized": false,
    "rememberPosition": true
  },
  "debug": {
    "enabled": false,
    "showFPS": false,
    "logWindowDetection": false
  },
  "future": {
    "ai": {
      "enabled": false,
      "provider": "openai",
      "model": "gpt-4"
    },
    "tts": {
      "enabled": false,
      "provider": "elevenlabs"
    },
    "integrations": {
      "email": false,
      "calendar": false,
      "fileOrganizer": false
    }
  }
}
